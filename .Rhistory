dtm_title_train=dtm_title_train[, freq_words_title]
dtm_title_test=dtm_title_test[, freq_words_title]
dim(dtm_title_train)
train=cbind(dtm_train, dtm_title_train) #ostateczny zbiór uczący i testowy
test=cbind(dtm_test, dtm_title_test)
